            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "409 ruta incompleta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenSupervisor}}"
          }
        ],
        "url": "{{baseUrl}}/rutas/{{rutaId}}/cierre"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear pesaje",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenOperario}}"
          }
        ],
        "url": "{{baseUrl}}/pesajes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"puntoId\": 1,\n  \"material\": \"PAPEL\",\n  \"pesoBruto\": 20,\n  \"tara\": 2,\n  \"observacion\": \"Demostración Postman\",\n  \"claveCliente\": \"{{$guid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"pesajeId\",pm.response.json().id);",
              "pm.test(\"Neto calculado por servidor\",()=>pm.expect(pm.response.json().pesoNeto).to.eql(18));"
            ]
          }
        }
      ]
    },
    {
      "name": "Corregir pesaje",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenOperario}}"
          }
        ],
        "url": "{{baseUrl}}/pesajes/{{pesajeId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"material\": \"PAPEL\",\n  \"pesoBruto\": 22,\n  \"tara\": 2,\n  \"observacion\": \"Corrección\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
