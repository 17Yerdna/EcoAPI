{
  "info": {
    "name": "EcoAPI · Evaluación Unidad 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    }
  ],
  "item": [
    {
      "name": "Login operario1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"operario1\",\n  \"contrasena\": \"Eco2026*\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"tokenOperario\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login supervisor1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"supervisor1\",\n  \"contrasena\": \"Eco2026*\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"tokenSupervisor\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"admin\",\n  \"contrasena\": \"Eco2026*\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "401 sin token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/rutas/dia"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ruta del día",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenOperario}}"
          }
        ],
        "url": "{{baseUrl}}/rutas/dia"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"rutaId\",pm.response.json().id);",
              "pm.collectionVariables.set(\"puntoId\",pm.response.json().puntos[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Puntos paginados",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenOperario}}"
          }
        ],
        "url": "{{baseUrl}}/puntos?pagina=0&tamanio=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contrato paginación\",()=>[\"contenido\",\"pagina\",\"tamanio\",\"totalElementos\",\"totalPaginas\",\"ultima\"].forEach(k=>pm.expect(pm.response.json()).to.have.property(k)));"
            ]
          }
        }
      ]
    },
    {
      "name": "403 admin no crea pesajes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "url": "{{baseUrl}}/pesajes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"puntoId\": 1,\n  \"material\": \"PAPEL\",\n  \"pesoBruto\": 10,\n  \"tara\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "400 neto inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenOperario}}"
          }
        ],
        "url": "{{baseUrl}}/pesajes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"puntoId\": 1,\n  \"material\": \"PAPEL\",\n  \"pesoBruto\": 2,\n  \"tara\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error por campo\",()=>pm.expect(pm.response.json().validationErrors).to.have.property(\"pesoBruto\"));"
            ]
          }
        }
      ]
    },
    {
