      "name": "403 operario no anula",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenOperario}}"
          }
        ],
        "url": "{{baseUrl}}/pesajes/{{pesajeId}}?motivo=Error"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anular supervisor",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenSupervisor}}"
          }
        ],
        "url": "{{baseUrl}}/pesajes/{{pesajeId}}?motivo=Error%20de%20balanza"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"204 sin cuerpo\",()=>pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
